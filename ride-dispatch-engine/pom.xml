<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.navya</groupId>
    <artifactId>ride-dispatch-engine</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Ride Dispatch Engine</name>
    <description>
        A geospatial ride-matching engine for a Dublin-themed ride-hailing
        demo: a from-scratch geohash implementation for spatial indexing,
        a single-writer-per-region concurrency model, a dependency-free
        REST gateway, and a latency/throughput benchmark harness.
    </description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.2</junit.version>
    </properties>

    <dependencies>
        <!-- Test-only dependency. The engine itself has zero runtime dependencies
             by design: matching logic, geohashing, the REST gateway (JDK
             HttpServer), and the benchmark harness are all pure JDK. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>ride-dispatch-engine</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

            <!-- Builds a single runnable jar with Main-Class set, so
                 `java -jar target/ride-dispatch-engine.jar` just works. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.navya.dispatchengine.sim.Main</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
